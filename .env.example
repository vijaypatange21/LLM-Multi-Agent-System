# Copy this file to `.env` and fill the secrets before running `docker-compose up`.

# App
ENV=development
API_PORT=8000

# Postgres - REQUIRED (no defaults)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=llm_multi_agent_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me

# Secret key for app (used for tokens/cryptographic operations)
SECRET_KEY=replace-with-secure-random
